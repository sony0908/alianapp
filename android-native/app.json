      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#df7446"
      },
      "permissions": [
        "INTERNET",
        "RECORD_AUDIO",
        "VIBRATE"
      ]
    }
  }
}
