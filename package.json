{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "start": "tsx server.ts",
    "build": "esbuild src/wardrobe-ui.ts --bundle --format=esm --outfile=dist/wardrobe.js --minify && node -e \"const fs=require('fs');fs.cpSync('dist/wardrobe.js','public/wardrobe.js');fs.cpSync('public','dist',{recursive:true});fs.cpSync('index.html','dist/index.html');\"",
    "preview": "tsx server.ts",
    "sync-wardrobe": "node scripts/fetch-wardrobe-inbox.mjs",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@google/genai": "^1.0.0",
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/three": "^0.170.0",
    "esbuild": "^0.25.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
