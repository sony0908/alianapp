<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@drawable/widget_background">

    <!-- Encabezado del Widget -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/widget_brand"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Bichito"
            android:textColor="@color/bichito_orange"
            android:textStyle="bold"
            android:textSize="17sp" />

        <TextView
            android:id="@+id/widget_updated_at"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Hoy"
            android:textColor="@color/bichito_muted"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Estado y Predicción de Siesta -->
    <LinearLayout
        android:id="@+id/widget_content_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="12dp">

        <TextView
            android:id="@+id/widget_next_nap"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Próxima siesta sugerida: ~15:30"
            android:textColor="@color/bichito_ink"
            android:textStyle="bold"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/widget_last_event"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Último registro: Biberón 180 ml"
            android:textColor="@color/bichito_muted"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Botones de Acción Rápida (Home Screen Shortcuts) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="38dp"
        android:orientation="horizontal"
        android:weightSum="3">

        <TextView
            android:id="@+id/btn_widget_feed"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginEnd="5dp"
            android:gravity="center"
            android:text="🍼 Comida"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#ffffff"
            android:background="@drawable/btn_orange"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/btn_widget_sleep"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginEnd="5dp"
            android:gravity="center"
            android:text="😴 Siesta"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#ffffff"
            android:background="@drawable/btn_blue"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/btn_widget_diaper"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="🚼 Pañal"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@color/bichito_ink"
            android:background="@drawable/btn_neutral"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>
</LinearLayout>
